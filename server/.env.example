# Port the API listens on
PORT=4000

# Frontend origin allowed to call this API (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Where contact-form submissions get delivered
CONTACT_TO_EMAIL=you@example.com

# SMTP credentials for sending real emails.
# Leave these blank to run in dev mode, which just logs submissions to the console
# instead of sending mail — handy for learning/testing without a real inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Upstash Redis for visitor stats and likes (copy from the Upstash console).
# On Vercel these arrive automatically as KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API key for the "ask about Navya" chat bot (console.anthropic.com).
# Leave blank to disable the bot; the chat bubble hides itself if the API is unavailable.
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-haiku-5-5, the cheapest/fastest)
CHAT_MODEL=